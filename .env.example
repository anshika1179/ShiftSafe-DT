# ShiftSafe-DT Environment Variables
# Copy to .env.local before running: cp .env.example .env.local

# Database
# Primary: Neon Serverless Postgres connection string
# Local development only: when unset, use SQLite at .data/shiftsafe.db. Production requires DATABASE_URL.
DATABASE_URL=
# Optional: retry transient Neon fetch/connectivity errors (default: 2)
NEON_QUERY_RETRIES=2
# Optional: base retry backoff delay in ms (default: 150)
NEON_QUERY_RETRY_DELAY_MS=150

# Retired trigger cron remains disabled; no recurring workflow enabled
CRON_SECRET=

# Admin portal authentication (required in production)
ADMIN_EMAIL=
# SHA-256 hash of admin password
# Example: node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
ADMIN_PASSWORD_HASH=
# Optional local-development fallback password when ADMIN_PASSWORD_HASH is not set
ADMIN_DEV_PASSWORD=
ADMIN_SESSION_SECRET=
WORKER_SESSION_SECRET=

# OTP demo code (for local/demo only). In production use real OTP integration.
OTP_MODE=disabled
OTP_DEMO_CODE=
NEXT_PUBLIC_SHOW_DEMO_OTP=false
NEXT_PUBLIC_DEMO_OTP_HINT=

# Legacy keys unused by active environment/quote routes (keyless Open-Meteo; missing data stays unknown)
OPENWEATHER_API_KEY=
AQICN_API_KEY=

# No sample ledger by default, never seeded in production.
SEED_DEMO_DATA=false
# Explicit, local-only switches. They cannot enable production OTP or simulation.
ENABLE_LOCAL_SIMULATION=false
ALLOW_SQLITE_FAILOVER=false
# Optional isolated local database path
SQLITE_DB_PATH=
